#!/bin/bash --login
# Generated by generate_aifs_jobs.py from case @@CASE_ID@@
#SBATCH --job-name=@@JOB_NAME@@
#SBATCH --nodes=@@NODES@@
@@SLURM_HEADER@@
#SBATCH --ntasks-per-node=@@PARENT_TASKS_PER_NODE@@
#SBATCH --cpus-per-task=@@CPUS_PER_TASK@@
#SBATCH --hint=nomultithread
#SBATCH --time=@@TIME_LIMIT@@
#SBATCH --output=logs/%x-%j.slurm.out

set -euo pipefail

script_source=${BASH_SOURCE[0]}
if [[ "$script_source" == /var/spool/slurm/* ]]; then
  submit_dir=${SLURM_SUBMIT_DIR:?SLURM_SUBMIT_DIR is required for an sbatch job}
  if [[ -f "$submit_dir/generate_aifs_jobs.py" ]]; then
    script_dir=$(cd -- "$submit_dir" && pwd -P)
  elif [[ -f "$submit_dir/../../generate_aifs_jobs.py" ]]; then
    script_dir=$(cd -- "$submit_dir/../.." && pwd -P)
  else
    echo "cannot find direct repository from SLURM_SUBMIT_DIR=$submit_dir" >&2
    exit 2
  fi
else
  if [[ "$script_source" != /* ]]; then
    script_source="$PWD/$script_source"
  fi
  script_dir=$(cd -- "$(dirname -- "$script_source")/@@SCRIPT_DIR_TO_REPO@@" && pwd -P)
fi
job_token=${SLURM_JOB_ID:-manual-$$}
host_job_dir="$script_dir/.aifs-job-scripts/$job_token/@@SAFE_ID@@"
container_job_dir="/work/.aifs-job-scripts/$job_token/@@SAFE_ID@@"
mounts=@@MOUNTS@@
mkdir -p "$script_dir/logs" "$script_dir/graphs" "$host_job_dir"
export AIFS_CONTAINER_JOB_DIR="$container_job_dir"
export SLURM_OVERLAP=1
export NCCL_MNNVL_ENABLE=@@NCCL_MNNVL_ENABLE@@
@@ENV_EXPORTS@@
export NCCL_DEBUG_SUBSYS=INIT,IB,BOOTSTRAP,ENV,NET,GRAPH,TUNING,ALLOC,CALL,NVLS,REG,PROFILE,RAS
export NCCL_DEBUG=INFO
export NCCL_DEBUG_FILE="$RUNDIR/nccl.%h.%p"

setup_distributed_env() {
  local master_host=""
  if [[ -n "${SLURM_NODELIST:-}" ]] && command -v scontrol >/dev/null; then
    master_host=$(scontrol show hostname "$SLURM_NODELIST" | head -n 1 || true)
  fi
  if [[ -z "$master_host" ]]; then
    master_host=$(hostname -s || hostname)
  fi

  local master_addr=""
  if command -v getent >/dev/null; then
    master_addr=$(getent ahostsv4 "$master_host" | awk '{ print $1; exit }' || true)
  fi
  if [[ -z "$master_addr" ]] && command -v nslookup >/dev/null; then
    master_addr=$(nslookup "$master_host" | awk '/^Address: / && $2 ~ /^[0-9.]+$/ { print $2; exit }' || true)
  fi
  if [[ -n "$master_addr" ]]; then
    export MASTER_ADDR="$master_addr"
  elif [[ "${SLURM_NNODES:-1}" == 1 ]]; then
    export MASTER_ADDR=127.0.0.1
  else
    export MASTER_ADDR="$master_host"
  fi
  export MASTER_PORT="${MASTER_PORT:-29500}"
  echo "AIFS_DISTRIBUTED MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT" >&2
}

@@HELPER_SCRIPTS@@
chmod +x "$host_job_dir"/*.sh

srun_args=(
  --overlap
  --exact
  --nodes=@@NODES@@
  -n @@SRUN_TASKS@@
  --ntasks-per-node=@@PARENT_TASKS_PER_NODE@@
  --cpus-per-task=@@CPUS_PER_TASK@@
  --mpi=pmix
  --container-image=@@IMAGE@@
  --container-mounts "$mounts"
  --container-name=@@CONTAINER_NAME@@
  --container-workdir=/work
)
@@CFG_SRUN_ARGS@@

setup_distributed_env
set -x
@@CONFIG_PREVIEW@@srun "${srun_args[@]}" bash "$AIFS_CONTAINER_JOB_DIR/@@RUN_SCRIPT@@"
set +x
